# ocpp-cp-admin — Environment file for systemd EnvironmentFile=
# Copy to /etc/ocpp-cp-admin/env and set chmod 600
#
# These variables override the values in config/config.json.
# Only the variables relevant to your deployment need to be set.

# ── Déploiement / URLs ──────────────────────────────────────────────────────
# URL publique de l'interface web (utilisée dans les liens des notifications)
CPADMIN_PUBLIC_URL=https://cpadmin.example.com

# Adresse d'écoute HTTP (0.0.0.0 pour toutes les interfaces)
CPADMIN_HTTP_HOST=0.0.0.0

# Faire confiance au reverse proxy pour les en-têtes X-Forwarded-* (true/false)
CPADMIN_TRUST_PROXY=true

# URL WebSocket OCPP non chiffré (bornes sans TLS)
CPADMIN_OCPP_WS_URL=ws://ws.cpadmin.example.com

# URL WebSocket OCPP chiffré, TLS terminé par le reverse proxy
CPADMIN_OCPP_WSS_URL=wss://ws.cpadmin.example.com

# URL FTP où les bornes déposent leurs fichiers de diagnostic
#CPADMIN_DIAGNOSTICS_URL=ftp://ftp.cpadmin.example.com

# Certificat racine du serveur WSS, téléchargeable depuis l'interface pour les bornes qui ne le
# connaissent pas (chemin relatif au dossier config/). Let's Encrypt : racine fournie avec l'app.
#CPADMIN_OCPP_WSS_ROOT_CA_FILE=certs/isrg-root-x1.pem

# ── Sécurité ────────────────────────────────────────────────────────────────
# OBLIGATOIRE : secret de session (min. 32 caractères aléatoires)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPADMIN_SESSION_SECRET=change-me-with-a-random-secret-of-at-least-32-chars

# ── Activation des fonctionnalités ─────────────────────────────────────────
# Activer HTTPS pour l'interface web (nécessite certFile/keyFile dans config.json)
#CPADMIN_WEBUI_HTTPS_ENABLED=true

# Activer le serveur WebSocket OCPP chiffré (WSS natif, TLS terminé par le serveur)
#CPADMIN_OCPP_WSS_ENABLED=true

# ── Comportement OCPP ───────────────────────────────────────────────────────
# Activer le support OCPP 1.6
#CPADMIN_OCPP_V16_ENABLED=true

# Activer le support OCPP 2.0.1
#CPADMIN_OCPP_V201_ENABLED=false

# Mode strict OCPP (rejet des messages non conformes)
CPADMIN_OCPP_STRICT_MODE=false

# Ajouter automatiquement les bornes inconnues (à éviter sur un serveur exposé à Internet :
# tout équipement qui se connecte serait enregistré)
CPADMIN_OCPP_AUTO_ADD=false

# Mettre les bornes inconnues en attente d'approbation (nécessite OCPP_AUTO_ADD=false)
CPADMIN_OCPP_PENDING_UNKNOWN=true

# Délai (secondes) d'attente de la réponse d'une borne à une commande OCPP
#CPADMIN_OCPP_CALL_TIMEOUT=45

# Refuser les connexions qui ne respectent aucun profil de sécurité OCPP (WS + mot de passe,
# WSS + mot de passe, WSS + certificat client) — indépendamment pour 1.6 et 2.0.1
#CPADMIN_OCPP_V16_ENFORCE_SECURITY_PROFILE=false
#CPADMIN_OCPP_V201_ENFORCE_SECURITY_PROFILE=false

# Derrière un reverse proxy qui termine le TLS et pose X-Forwarded-Proto : afficher en WSS les
# bornes connectées en wss:// au proxy (classement seulement, aucun effet sur l'authentification)
#CPADMIN_OCPP_TRUST_PROXY_PROTO=false

# ── Configuration générale ──────────────────────────────────────────────────
# Niveau de log : error | warn | info | debug | trace
CPADMIN_LOGLEVEL=info

# Langue par défaut de l'interface : fr | en
#CPADMIN_LANGUAGE=fr

# Nom du CPO affiché dans l'interface
#CPADMIN_CPO_NAME=Mon CPO

# ── Rétention des données (durées en jours, 0 = jamais) ─────────────────────
# Tâche quotidienne : données techniques échues supprimées, sessions échues anonymisées.
# Instance mise à jour : inactive tant que non activée (vérifier l'aperçu dans
# Administration système → Nettoyage et faire une sauvegarde avant d'activer).
#CPADMIN_RETENTION_ENABLED=true
#CPADMIN_RETENTION_OCPP_MESSAGES_DAYS=90
#CPADMIN_RETENTION_REJECTIONS_DAYS=365
#CPADMIN_RETENTION_ERROR_EVENTS_DAYS=365
#CPADMIN_RETENTION_RESERVATIONS_DAYS=365
#CPADMIN_RETENTION_NOTIFICATIONS_DAYS=365
#CPADMIN_RETENTION_METER_VALUES_DAYS=730
#CPADMIN_RETENTION_SESSIONS_DAYS=1825

# ── Comportement par défaut des notifications ───────────────────────────────
# Événements désactivés par défaut pour les utilisateurs sans préférences enregistrées.
# Ces utilisateurs reçoivent normalement tous les événements de leur rôle par email.
# Lister les événements à exclure par défaut (séparés par virgule) — opt-in utilisateur requis.
# Valeurs possibles : server_started, server_stopping, pending_chargepoint, autoadd_chargepoint,
#   chargepoint_refused, diagnostics_upload, firmware_status, init_config_result, duplicate_identity,
#   identity_flapping, chargepoint_online, chargepoint_offline, chargepoint_heartbeat_timeout,
#   connector_available, connector_unavailable, connector_error, repeated_auth_rejected,
#   site_transaction_started, site_transaction_stopped, transaction_started,
#   transaction_stopped, charge_suspended_ev
#CPADMIN_NOTIF_DISABLED_EVENTS=connector_available,connector_unavailable

# Délai de grâce (secondes) avant d'envoyer la notification "borne hors ligne".
# Si la borne se reconnecte dans ce délai, les notifications offline/online sont supprimées. (défaut : 60)
#CPADMIN_NOTIF_RECONNECT_GRACE_PERIOD=60

# Délai de debounce (secondes) avant envoi des notifications Available/Unavailable.
# Évite les notifications parasites des bornes qui alternent rapidement le statut à la connexion. (défaut : 5)
#CPADMIN_NOTIF_AVAILABILITY_DEBOUNCE=5

# ── Notifications e-mail (optionnel) ────────────────────────────────────────
#CPADMIN_MAIL_ENABLED=true
#CPADMIN_MAIL_HOST=smtp.example.com
#CPADMIN_MAIL_PORT=587
#CPADMIN_MAIL_SECURE=false
#CPADMIN_MAIL_USER=user@example.com
#CPADMIN_MAIL_PASS=password
#CPADMIN_MAIL_FROM=noreply@cpadmin.example.com

# ── Notifications Web Push (optionnel) ──────────────────────────────────────
# Générer les clés VAPID : npx web-push generate-vapid-keys
#CPADMIN_WEBPUSH_ENABLED=true
#CPADMIN_VAPID_SUBJECT=mailto:admin@cpadmin.example.com
#CPADMIN_VAPID_PUBLIC_KEY=
#CPADMIN_VAPID_PRIVATE_KEY=

# ── Notifications Pushover (optionnel) ──────────────────────────────────────
#CPADMIN_PUSHOVER_ENABLED=true

# ── Authentification Google OAuth (optionnel) ────────────────────────────────
#CPADMIN_GOOGLE_AUTH_ENABLED=true
#CPADMIN_GOOGLE_CLIENT_ID=
#CPADMIN_GOOGLE_CLIENT_SECRET=

# ── Métriques Prometheus (optionnel) ────────────────────────────────────────
# Si défini, le endpoint GET /metrics exige ce token en Authorization: Bearer <token>
# Laisser vide pour un accès libre (réseau interne / Docker uniquement)
#CPADMIN_METRICS_TOKEN=
